# Copy to .env and fill in (deploy.sh does this for you).

# The address the apps and browsers use. Point the domain's DNS (an A record) at this
# server first. No domain? <ip-with-dashes>.sslip.io works, e.g. 203-0-113-7.sslip.io.
KITHARA_DOMAIN=books.example.com

# The name shown in the apps and on the web page.
KITHARA_NAME=Kithara

# The first library: Name=folder inside the container (./books on this server is /books).
KITHARA_LIBRARY=Audiobooks=/books/Audiobooks

# Which release to run: 0.8 follows 0.8.x updates; latest follows everything;
# 0.8-vulkan or latest-vulkan for the GPU image (see the README).
KITHARA_IMAGE_TAG=0.8
