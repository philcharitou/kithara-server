# Copy to .env and fill in (deploy.sh does this for you).

# public: a server on the internet, with Caddy for HTTPS on ports 80 and 443.
# Empty: at home, reached through Tailscale (deploy.sh --home), no ports opened.
COMPOSE_PROFILES=public

# The address the apps and browsers use (public only). Point the domain's DNS (an A
# record) at this server first. No domain? <ip-with-dashes>.sslip.io works.
KITHARA_DOMAIN=books.example.com

# The name shown in the apps and on the web page.
KITHARA_NAME=Kithara

# The first library: Name=folder inside the container (./books on this server is /books).
KITHARA_LIBRARY=Audiobooks=/books/Audiobooks

# Which release to run: 0.9 follows 0.9.x updates; latest follows everything;
# 0.9-vulkan or latest-vulkan for the GPU image (see the README).
KITHARA_IMAGE_TAG=0.9
